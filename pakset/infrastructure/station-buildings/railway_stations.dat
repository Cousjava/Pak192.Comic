Obj=building
name=Fachwerkbahnhof
copyright=PappeTeeMaster
intro_month=1
intro_year=1900
type=extension
#level=8
capacity=500
cost=500000
maintenance=75000
needs_ground=1
#climates=mediterran, temperate, tundra, rocky
enables_post=1
enables_pax=1
noinfo=1
icon=> ./images/Fachwerkbahnhof_menu.0.0
cursor=./images/Fachwerkbahnhof_menu.0.1
Dims=2,1,2
BackImage[1][0][0][0][0][0]=./images/Fachwerkbahnhof.0.3
BackImage[1][1][0][0][0][0]=./images/Fachwerkbahnhof.0.2
BackImage[0][0][0][0][0][0]=./images/Fachwerkbahnhof.0.0
BackImage[0][0][1][0][0][0]=./images/Fachwerkbahnhof.0.1
BackImage[1][0][0][0][0][1]=./images/Fachwerkbahnhof.1.3
BackImage[1][1][0][0][0][1]=./images/Fachwerkbahnhof.1.2
BackImage[0][0][0][0][0][1]=./images/Fachwerkbahnhof.1.0
BackImage[0][0][1][0][0][1]=./images/Fachwerkbahnhof.1.1
